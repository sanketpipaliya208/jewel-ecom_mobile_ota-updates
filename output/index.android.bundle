 silver, hallmarked, and accompanied by a certificate of purity and authenticity."}],x=[{id:"all",label:"All Questions",icon:"help-circle-outline"},{id:"orders",label:"Orders",icon:"cube-outline"},{id:"shipping",label:"Shipping",icon:"bus-outline"},{id:"returns",label:"Returns",icon:"refresh-outline"},{id:"payments",label:"Payments",icon:"card-outline"}],p=()=>{var e,o=(0,s.c)(28),p=(0,l.useState)(""),b=(0,t.default)(p,2),y=b[0],w=b[1],j=(0,l.useState)("all"),N=(0,t.default)(j,2),v=N[0],k=N[1],P=(0,l.useState)(null),q=(0,t.default)(P,2),S=q[0],C=q[1];o[0]!==y||o[1]!==v?(e=h.filter(e=>{var t="all"===v||e.category===v,s=e.question.toLowerCase().includes(y.toLowerCase())||e.answer.toLowerCase().includes(y.toLowerCase());return t&&s}),o[0]=y,o[1]=v,o[2]=e):e=o[2];var V,I=e;o[3]!==S?(V=e=>{C(S===e?null:e)},o[3]=S,o[4]=V):V=o[4];var T,_,z,O,W,L,M,G,H,R,A=V;return o[5]===Symbol.for("react.memo_cache_sentinel")?(T=(0,u.jsxs)(c.View,{className:"flex-row items-center px-4 pt-12 pb-3 bg-background border-b border-muted/10",children:[(0,u.jsx)(c.Pressable,{onPress:f,hitSlop:20,children:(0,u.jsx)(n.default,{name:"arrow-back",size:22,className:"text-[#3a3a3a]"})}),(0,u.jsx)(c.Text,{className:"text-lg font-bold text-foreground ml-3",children:"FAQs"})]}),o[5]=T):T=o[5],o[6]===Symbol.for("react.memo_cache_sentinel")?(_=(0,u.jsx)(n.default,{name:"search-outline",size:18,className:"text-muted"}),o[6]=_):_=o[6],o[7]!==y?(z=(0,u.jsx)(c.TextInput,{placeholder:"Search frequently asked questions...",value:y,onChangeText:w,placeholderTextColor:"#71717a",className:"flex-1 text-sm text-foreground py-1"}),o[7]=y,o[8]=z):z=o[8],o[9]!==y.length?(O=y.length>0&&(0,u.jsx)(c.Pressable,{onPress:()=>w(""),hitSlop:10,children:(0,u.jsx)(n.default,{name:"close-circle",size:16,className:"text-muted"})}),o[9]=y.length,o[10]=O):O=o[10],o[11]!==z||o[12]!==O?(W=(0,u.jsx)(c.View,{className:"p-4",children:(0,u.jsxs)(c.View,{className:"flex-row items-center border border-muted/20 px-3 py-2 bg-muted/5 gap-x-2",ch